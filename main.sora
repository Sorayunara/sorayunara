// ==============================================================================
// 🌌 Sorayunara (.sora) Main Showcase Program
// Organization: Sorayunara · Safe · Fast · Expressive · Multi-Target Systems Language
// ==============================================================================

fn add(a: Int, b: Int) -> Int {
    return a + b
}

fn multiply(a: Int, b: Int) -> Int {
    return a * b
}

fn compute_power(base: Int, exp: Int) -> Int {
    let mut result: Int = 1
    let mut i: Int = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

fn evaluate_grade(score: Int) -> Int {
    if score >= 90 {
        return 1
    } else if score >= 80 {
        return 2
    } else {
        return 3
    }
}

fn main() -> Int {
    print("===============================================================")
    print("🌌 SORAYUNARA PROGRAMMING LANGUAGE: UNIFIED RUNTIME (.sora)")
    print("   Safe · Fast · Expressive · Multi-Target LLVM / C / WASM")
    print("===============================================================")

    let x: Int = 15
    let y: Int = 25
    let sum: Int = add(x, y)
    let prod: Int = multiply(x, y)
    let pow_val: Int = compute_power(2, 8)
    let grade: Int = evaluate_grade(95)

    print("x + y = ", sum)
    print("x * y = ", prod)
    print("2 ^ 8 = ", pow_val)
    print("Grade Code: ", grade)

    assert(sum == 40)
    assert(prod == 375)
    assert(pow_val == 256)

    print("===============================================================")
    print("✅ All Core Language Systems Operational & Verified (.sora)")
    print("===============================================================")
    return sum
}
