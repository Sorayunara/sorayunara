{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sorayunara",
  "scopeName": "source.sorayunara",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sorayunara",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sorayunara",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sorayunara",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sorayunara",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sorayunara",
          "match": "\\b(if|else|match|while|for|in|return|break|continue|async|await|spawn)\\b"
        },
        {
          "name": "keyword.declaration.sorayunara",
          "match": "\\b(fn|let|mut|struct|enum|impl|type|const|pub|import)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.sorayunara",
          "match": "\\b(Int|Float|Bool|String|Char|Void)\\b"
        },
        {
          "name": "entity.name.type.generic.sorayunara",
          "match": "\\b(Array|Map|Option|Result|Channel)\\b"
        },
        {
          "name": "entity.name.type.custom.sorayunara",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.sorayunara",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sorayunara",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.sorayunara",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sorayunara",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\=|\\=\\=|\\!\\=|\\<|\\>|\\<\\=|\\>\\=|\\&|\\||\\-\\>|\\=\\>)"
        }
      ]
    }
  }
}
