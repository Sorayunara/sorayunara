{
  "Sorayunara Function": {
    "prefix": ["sora-fn", "fn"],
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:Int} {",
      "    ${0}",
      "    return 0",
      "}"
    ],
    "description": "Declare a typed Sorayunara function"
  },
  "Sorayunara Async Function": {
    "prefix": ["sora-async", "asyncfn"],
    "body": [
      "async fn ${1:name}(${2:params}) -> ${3:Result<String, String>} {",
      "    ${0}",
      "    return Result::Ok(\"done\")",
      "}"
    ],
    "description": "Declare an asynchronous function in Sorayunara"
  },
  "Sorayunara Main Entrypoint": {
    "prefix": ["sora-main", "main"],
    "body": [
      "import std.io",
      "",
      "fn main() -> Int {",
      "    print(\"🌌 Sorayunara runtime active.\")",
      "    ${0}",
      "    return 0",
      "}"
    ],
    "description": "Sorayunara standard application entry point"
  },
  "Sorayunara Struct": {
    "prefix": ["sora-struct", "struct"],
    "body": [
      "struct ${1:Name} {",
      "    ${2:field_name}: ${3:String},",
      "    ${4:is_active}: ${5:Bool}",
      "}"
    ],
    "description": "Declare a Sorayunara struct"
  },
  "Sorayunara Impl Block": {
    "prefix": ["sora-impl", "impl"],
    "body": [
      "impl ${1:Name} {",
      "    pub fn new(${2:params}) -> ${1:Name} {",
      "        return ${1:Name} {",
      "            ${0}",
      "        }",
      "    }",
      "}"
    ],
    "description": "Create a method implementation block for a struct"
  },
  "Sorayunara Enum": {
    "prefix": ["sora-enum", "enum"],
    "body": [
      "enum ${1:Name} {",
      "    ${2:VariantA},",
      "    ${3:VariantB}(${4:Int})",
      "}"
    ],
    "description": "Declare an algebraic data type (ADT) enum"
  },
  "Sorayunara Pattern Matching": {
    "prefix": ["sora-match", "match"],
    "body": [
      "match ${1:expression} {",
      "    ${2:Pattern} => {",
      "        ${0}",
      "    },",
      "    _ => {",
      "        // Default fallback",
      "    }",
      "}"
    ],
    "description": "Exhaustive pattern matching construct"
  },
  "Sorayunara Spawn Worker": {
    "prefix": ["sora-spawn", "spawn"],
    "body": [
      "spawn async {",
      "    ${0}",
      "}"
    ],
    "description": "Spawn an asynchronous coroutine worker"
  },
  "Sorayunara Channel": {
    "prefix": ["sora-channel", "channel"],
    "body": [
      "let ${1:ch}: Channel<${2:String}> = channel::new(${3:1024})"
    ],
    "description": "Create a high-performance concurrency channel"
  },
  "Sorayunara Unit Test": {
    "prefix": ["sora-test", "test"],
    "body": [
      "fn test_${1:feature_name}() {",
      "    let val = ${2:1 + 1}",
      "    assert(val == ${3:2}, \"Test assertion failed\")",
      "}"
    ],
    "description": "Create an assert-based unit test function"
  }
}
