{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aether",
  "scopeName": "source.aether",
  "patterns": [
    {
      "name": "comment.line.double-slash.aether",
      "match": "//.*$"
    },
    {
      "name": "comment.block.aether",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.aether",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aether",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.aether",
      "match": "\\b(if|else|while|loop|for|in|return|match|spawn|await|comptime|test|import|pub|mut)\\b"
    },
    {
      "name": "keyword.declaration.aether",
      "match": "\\b(fn|let|struct|enum|trait|impl|type|const)\\b"
    },
    {
      "name": "entity.name.type.primitive.aether",
      "match": "\\b(Int|Float|String|Bool|Char|Option|Result|Task|Chan|RawPointer)\\b"
    },
    {
      "name": "constant.language.boolean.aether",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "constant.numeric.aether",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "entity.name.function.aether",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    },
    {
      "name": "meta.attribute.aether",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    }
  ]
}
