{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nami",
  "scopeName": "source.nami",
  "patterns": [
    {
      "name": "comment.line.double-slash.nami",
      "match": "//.*$"
    },
    {
      "name": "comment.block.nami",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.nami",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nami",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.nami",
      "match": "\\b(if|else|while|loop|for|in|return|match|spawn|await|comptime|test|import|pub|mut)\\b"
    },
    {
      "name": "keyword.declaration.nami",
      "match": "\\b(fn|let|struct|enum|trait|impl|type|const)\\b"
    },
    {
      "name": "entity.name.type.primitive.nami",
      "match": "\\b(Int|Float|String|Bool|Char|Option|Result|Task|Chan|RawPointer)\\b"
    },
    {
      "name": "constant.language.boolean.nami",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "constant.numeric.nami",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "entity.name.function.nami",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    }
  ]
}
