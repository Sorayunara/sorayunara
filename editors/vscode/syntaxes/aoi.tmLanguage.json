{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aoi",
  "scopeName": "source.aoi",
  "patterns": [
    {
      "name": "comment.line.double-slash.aoi",
      "match": "//.*$"
    },
    {
      "name": "comment.block.aoi",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.aoi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aoi",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.aoi",
      "match": "\\b(if|else|while|loop|for|in|return|match|spawn|await|comptime|test|import|pub|mut|move|unsafe)\\b"
    },
    {
      "name": "keyword.declaration.aoi",
      "match": "\\b(fn|let|struct|enum|trait|impl|type|const)\\b"
    },
    {
      "name": "entity.name.type.primitive.aoi",
      "match": "\\b(Int|Float|String|Bool|Char|Option|Result|Task|Chan|RawPointer|Void)\\b"
    },
    {
      "name": "constant.language.boolean.aoi",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "constant.numeric.aoi",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "entity.name.function.aoi",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    }
  ]
}
