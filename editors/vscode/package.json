{
  "name": "sorayunara",
  "displayName": "Sorayunara Language Support",
  "description": "Unified Language Support for Sorayunara (.sora): Hindley-Milner Type Inference, LSP Server, DAP Debugger, Formatter, Package Manager, and Syntax Highlighting.",
  "version": "0.2.2",
  "publisher": "muhammadlutfimuzaki",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sorayunara/sorayunara"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Debuggers"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sorayunara",
        "aliases": ["Sorayunara", "sorayunara"],
        "extensions": [".sora"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sora-light.png",
          "dark": "./icons/sora-dark.png"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "sorayunara-icons",
        "label": "Sorayunara File Icons",
        "path": "./icons/sorayunara-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "sorayunara",
        "scopeName": "source.sorayunara",
        "path": "./syntaxes/sorayunara.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sorayunara",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "sorayunara.run",
        "title": "Sorayunara: Run Active File",
        "category": "Sorayunara"
      },
      {
        "command": "sorayunara.build",
        "title": "Sorayunara: Build Active File / Project",
        "category": "Sorayunara"
      },
      {
        "command": "sorayunara.test",
        "title": "Sorayunara: Run Test Suite",
        "category": "Sorayunara"
      },
      {
        "command": "sorayunara.format",
        "title": "Sorayunara: Format Active Document",
        "category": "Sorayunara"
      },
      {
        "command": "sorayunara.check",
        "title": "Sorayunara: Type Check & Verify",
        "category": "Sorayunara"
      },
      {
        "command": "sorayunara.debug",
        "title": "Sorayunara: Start Debug Session",
        "category": "Sorayunara"
      },
      {
        "command": "sorayunara.restartLsp",
        "title": "Sorayunara: Restart Language Server (LSP)",
        "category": "Sorayunara"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .sora",
          "command": "sorayunara.run",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Sorayunara",
      "properties": {
        "sorayunara.executablePath": {
          "type": "string",
          "default": "sorayunara",
          "description": "Path to the sorayunara executable compiler & LSP server"
        },
        "sorayunara.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable Sorayunara Language Server Protocol (LSP) daemon"
        },
        "sorayunara.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically format document on save"
        }
      }
    }
  }
}
