// tests/integration/full_pipeline.sora — End-to-end full pipeline test fixture
fn factorial(n: Int) -> Int {
    let mut result = 1
    let mut i = 1
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

fn main() -> Int {
    let fact5 = factorial(5)
    assert(fact5 == 120)
    print("Full pipeline test OK: factorial(5) = ", fact5)
    return 0
}
