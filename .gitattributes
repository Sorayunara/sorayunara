# ==============================================================================
# GitHub Linguist Configuration for Sorayunara Repository
# ==============================================================================

# 1. Primary Sorayunara Language Sources (.sora)
*.sora linguist-detectable=true
compiler/*.sora linguist-detectable=true
std/*.sora linguist-detectable=true
runtime/*.sora linguist-detectable=true
examples/*.sora linguist-detectable=true
tools/*.sora linguist-detectable=true

# 2. Mark Rust Bootstrap Toolchain as Vendored / Bootstrap Scaffolding
# This excludes Rust from dominating the repository language statistics
src/** linguist-vendored=true
tests/** linguist-vendored=true
Cargo.toml linguist-vendored=true
Cargo.lock linguist-vendored=true
target/** linguist-vendored=true
output.* linguist-generated=true
