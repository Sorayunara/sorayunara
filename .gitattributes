# ==============================================================================
# GitHub Linguist Configuration for Sorayunara
# ==============================================================================

# 1. Primary Language: Sorayunara (.sora)
*.sora linguist-language=Sorayunara
*.sora linguist-detectable

# 2. Exclude all Rust bootstrap, scripts, and build files
*.rs linguist-vendored
*.rs linguist-generated
*.toml linguist-vendored
*.lock linguist-vendored
*.ps1 linguist-vendored
*.sh linguist-vendored
*.bat linguist-vendored
Cargo.toml linguist-vendored
Cargo.lock linguist-vendored
bootstrap/** linguist-vendored
tests/** linguist-vendored
tools/** linguist-vendored
linguist-submission/** linguist-vendored
target/** linguist-vendored
output.* linguist-generated

# 3. Exclude Web Playground, VS Code Tooling, Assets & Docs from language statistics
playground/** linguist-vendored
editors/** linguist-vendored
assets/** linguist-vendored
docs/** linguist-documentation
demo-service/** linguist-vendored

