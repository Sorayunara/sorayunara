# ==============================================================================
# GitHub Linguist Configuration for Sorayunara Programming Language (.sora)
# ==============================================================================

# 1. Primary Programming Language: Sorayunara
*.sora linguist-language=Sorayunara
*.sora linguist-detectable=true
*.sora -linguist-vendored
*.sora -linguist-generated

# 2. Mark Rust bootstrap compiler, toolchain scripts & package manifests as vendored
# This ensures that Sorayunara (.sora) is recognized as the language of this repository
bootstrap/** linguist-vendored
src/**/*.rs linguist-vendored
tests/**/*.rs linguist-vendored
tools/**/*.rs linguist-vendored
*.rs linguist-vendored
*.toml linguist-vendored
*.lock linguist-generated
*.ps1 linguist-vendored
*.sh linguist-vendored
*.bat linguist-vendored

# 3. Build outputs, IDE plugins & documentation
target/** linguist-vendored
output.* linguist-generated
playground/** linguist-vendored
editors/** linguist-vendored
assets/** linguist-vendored
docs/** linguist-documentation
*.md linguist-documentation
