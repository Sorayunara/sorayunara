// benchmarks/compiler/lex_bench.sora
fn is_identifier_char(c: Int) -> Bool {
    return c >= 65 && c <= 122
}

fn main() -> Int {
    let mut count: Int = 0
    let mut i: Int = 0
    while i < 10000 {
        if is_identifier_char(65 + (i % 58)) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
