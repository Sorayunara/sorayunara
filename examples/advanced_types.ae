enum NetworkState {
    Connecting
    Connected(Int)
    Failed(String)
}

fn max<T: Comparable>(a: T, b: T) -> T {
    if a < b {
        return b
    }
    return a
}

fn report(value: Int | String) {
    if value is String {
        println(value.length())
    } else {
        println(value)
    }
}

fn status_code(state: NetworkState) -> Int {
    return match state {
        Connecting => 0
        Connected(socket) => socket
        Failed(error) => -1
    }
}

fn main() {
    let largest = max(100, 200)
    let state = NetworkState::Connected(largest)
    report("connected")
    let code = status_code(state)
    println(code)
}
