// examples/io.sora — I/O Stream Operations in Sorayunara (.sora)
import std.io

fn main() -> Int {
    print("🌌 Sorayunara I/O Stream Operations:")
    print("Writing content to standard output...")

    let message: String = "Sorayunara high-performance native I/O stream"
    print("Output: ", message)

    let status: Int = 1
    print("I/O Operation Status: ", status)

    assert(status == 1)
    return 0
}
