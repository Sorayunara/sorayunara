// examples/primes.sora — Prime Number Sieve & Generator in Sorayunara (.sora)

fn is_prime(n: Int) -> Bool {
    if n <= 1 {
        return false
    }
    if n <= 3 {
        return true
    }
    if (n % 2 == 0) || (n % 3 == 0) {
        return false
    }

    let mut i = 5
    while (i * i) <= n {
        if (n % i == 0) || (n % (i + 2) == 0) {
            return false
        }
        i = i + 6
    }
    return true
}

fn count_primes(limit: Int) -> Int {
    let mut count = 0
    let mut num = 2
    while num <= limit {
        if is_prime(num) {
            count = count + 1
        }
        num = num + 1
    }
    return count
}

fn main() -> Int {
    print("🌌 Sorayunara Prime Generator (Limit: 50):")
    let total: Int = count_primes(50)
    print("Total Primes Found: ", total)
    assert(total == 15)
    return total
}
