// examples/ffi_demo.ae
// Demonstrasi Foreign Function Interface (FFI) Aether.
//
// Fungsi native dari C dapat dideklarasikan langsung di Aether,
// lalu dipanggil seperti fungsi biasa. Saat dikompilasi ke C/LLVM,
// deklarasi ini menjadi prototype asli yang di-resolve oleh linker.

// libm (math.h) — link dengan: -lm
@link("m")
extern "C" {
    fn sqrt(x: Float) -> Float
    fn pow(base: Float, exp: Float) -> Float
    fn fabs(x: Float) -> Float
}

// libc (string.h)
extern "C" {
    fn strlen(s: String) -> Int
    fn strcmp(a: String, b: String) -> Int
}

fn main() {
    print("=== Aether FFI Demo ===")

    let root: Float = sqrt(144.0)
    print("sqrt(144.0)      = ", root)

    let cube: Float = pow(2.0, 10.0)
    print("pow(2.0, 10.0)   = ", cube)

    let abs_val: Float = fabs(-42.5)
    print("fabs(-42.5)      = ", abs_val)

    let len: Int = strlen("Hello, Aether!")
    print("strlen(...)      = ", len)

    if strcmp("aether", "aether") == 0 {
        print("strcmp equal     = OK")
    }
}
