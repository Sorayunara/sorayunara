// examples/structs.sora — Structs and Record Operations in Sorayunara (.sora)

fn point_distance_sq(x1: Int, y1: Int, x2: Int, y2: Int) -> Int {
    let dx: Int = x2 - x1
    let dy: Int = y2 - y1
    return (dx * dx) + (dy * dy)
}

fn rectangle_area(width: Int, height: Int) -> Int {
    return width * height
}

fn rectangle_perimeter(width: Int, height: Int) -> Int {
    return 2 * (width + height)
}

fn main() -> Int {
    // Point operations
    let dist_sq: Int = point_distance_sq(0, 0, 3, 4)
    print("Distance squared (0,0) -> (3,4): ", dist_sq)

    // Rectangle operations
    let area: Int = rectangle_area(40, 20)
    let perim: Int = rectangle_perimeter(40, 20)

    print("Rectangle Area: ", area)
    print("Rectangle Perimeter: ", perim)

    assert(dist_sq == 25)
    assert(area == 800)
    assert(perim == 120)

    return area
}
