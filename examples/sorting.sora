// examples/sorting.sora — Binary Search & Sort Algorithms in Sorayunara (.sora)
import std.io

fn binary_search(arr: &Array<Int>, target: Int) -> Option<Int> {
    let mut low = 0
    let mut high = arr.len() - 1

    while low <= high {
        let mid = (low + high) / 2
        let mid_val = arr[mid]

        if mid_val == target {
            return Option::Some(mid)
        } else if mid_val < target {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }

    return Option::None
}

fn main() -> Int {
    print("🌌 Sorayunara Binary Search Algorithm:")
    let numbers: Array<Int> = [3, 7, 12, 19, 25, 38, 42, 55, 68, 89, 99]
    let target = 42

    print("Searching for target: " + target.to_string())
    match binary_search(&numbers, target) {
        Option::Some(index) => print("Target found at index: " + index.to_string()),
        Option::None => print("Target not found in array.")
    }

    return 0
}
