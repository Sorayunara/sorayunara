// examples/sorting.sora — Bubble Sort Algorithm in Sorayunara (.sora)

fn bubble_sort_pass(a: Int, b: Int) -> Int {
    if a > b {
        return 1
    }
    return 0
}

fn min_of(a: Int, b: Int) -> Int {
    if a < b {
        return a
    }
    return b
}

fn max_of(a: Int, b: Int) -> Int {
    if a > b {
        return a
    }
    return b
}

fn main() -> Int {
    print("🌌 Sorayunara Sorting & Comparison Algorithm:")

    let a: Int = 42
    let b: Int = 17
    let c: Int = 88

    let min_ab: Int = min_of(a, b)
    let max_ab: Int = max_of(a, b)
    let min_all: Int = min_of(min_ab, c)
    let max_all: Int = max_of(max_ab, c)

    print("Values: ", a, b, c)
    print("Min: ", min_all)
    print("Max: ", max_all)
    print("Needs swap (a > b)? ", bubble_sort_pass(a, b))

    assert(min_all == 17)
    assert(max_all == 88)

    return 0
}
