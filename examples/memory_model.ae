// Aether Three-Mode Memory Model
// Managed · Owned · Unsafe
//
// Run with: cargo run -- run examples/memory_model.ae

// ---------------- Managed Mode (default) ----------------
// Values created with `let` are GC-managed: safe, no ownership tracking.

fn make_config() -> String {
    return "managed-config"
}

fn managed_mode() {
    let config = make_config()          // Managed: GC handles cleanup
    print("Managed  : ", config)
}

// ---------------- Owned Mode (move) ----------------
// `move` transfers ownership explicitly. The old binding is dead after move.
// Zero GC pause; compile-time `is_moved` tracking.

fn owned_mode() {
    let buffer = make_config()          // Owned: single owner
    let owner = move buffer             // ownership transferred
    // let reuse = buffer               // Compile Error: use of moved value
    print("Owned    : ", owner)
}

// ---------------- Unsafe Mode ----------------
// Raw pointer access must live inside `unsafe { ... }`.
// The compiler still type-checks the block.

extern "C" {
    fn malloc(size: Int) -> *mut Void
    fn free(ptr: *mut Void) -> Void
}

fn unsafe_mode() -> Int {
    let result: Int = unsafe {
        let p: *mut Void = malloc(1024)
        // ptr.write & manual deallocation are unchecked here
        free(p)
        42
    }
    print("Unsafe   : ", result)
    return result
}

fn main() {
    managed_mode()
    owned_mode()
    let code = unsafe_mode()
    if code == 42 {
        print("✅ Three-mode memory model OK")
    }
}