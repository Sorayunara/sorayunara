// examples/matrix.sora — 2x2 Matrix Math in Sorayunara (.sora)

fn matrix_multiply_a(a1: Int, b1: Int, c1: Int, d1: Int, a2: Int, b2: Int, c2: Int, d2: Int) -> Int {
    return (a1 * a2) + (b1 * c2)
}

fn matrix_multiply_b(a1: Int, b1: Int, c1: Int, d1: Int, a2: Int, b2: Int, c2: Int, d2: Int) -> Int {
    return (a1 * b2) + (b1 * d2)
}

fn matrix_multiply_c(a1: Int, b1: Int, c1: Int, d1: Int, a2: Int, b2: Int, c2: Int, d2: Int) -> Int {
    return (c1 * a2) + (d1 * c2)
}

fn matrix_multiply_d(a1: Int, b1: Int, c1: Int, d1: Int, a2: Int, b2: Int, c2: Int, d2: Int) -> Int {
    return (c1 * b2) + (d1 * d2)
}

fn determinant(a: Int, b: Int, c: Int, d: Int) -> Int {
    return (a * d) - (b * c)
}

fn main() -> Int {
    print("🌌 Sorayunara Matrix Multiplication Example:")

    // Matrix 1: [[1,2],[3,4]]
    // Matrix 2: [[5,6],[7,8]]
    let ra: Int = matrix_multiply_a(1, 2, 3, 4, 5, 6, 7, 8)
    let rb: Int = matrix_multiply_b(1, 2, 3, 4, 5, 6, 7, 8)
    let rc: Int = matrix_multiply_c(1, 2, 3, 4, 5, 6, 7, 8)
    let rd: Int = matrix_multiply_d(1, 2, 3, 4, 5, 6, 7, 8)

    print("Product Row 1: ", ra, rb)
    print("Product Row 2: ", rc, rd)

    let det: Int = determinant(ra, rb, rc, rd)
    print("Determinant of product: ", det)

    assert(ra == 19)
    assert(rb == 22)
    assert(rc == 43)
    assert(rd == 50)
    assert(det == 4)

    return 0
}
