// ==============================================================================
// 🌌 Sorayunara (.sora) Complete Grammar v2 Showcase
// Organization: Sorayunara · Safe · Fast · Expressive · Zero-Boilerplate
// ==============================================================================

// 1. Pure Functions & Return Expressions
fn add(a: Int, b: Int) -> Int {
    return a + b
}

fn square(x: Int) -> Int {
    return x * x
}

fn abs_value(n: Int) -> Int {
    if n < 0 {
        return 0 - n
    }
    return n
}

// 2. Pattern Matching (Int literals)
fn evaluate_status(code: Int) -> Int {
    let result = match code {
        200 => 1,
        404 => 2,
        _   => 0
    }
    return result
}

// 3. Branching & Conditionals
fn classify_grade(score: Int) -> Int {
    if score >= 90 {
        return 1
    } else if score >= 80 {
        return 2
    } else if score >= 70 {
        return 3
    } else {
        return 4
    }
}

// 4. Iteration with While Loop
fn compute_factorial(n: Int) -> Int {
    let mut result: Int = 1
    let mut i: Int = 1
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

// 5. Main Program Execution
fn main() -> Int {
    print("===============================================================")
    print("🌌 SORAYUNARA (.sora) FULL GRAMMAR V2 EXECUTION DEMO")
    print("===============================================================")

    // Function Calls
    let sum: Int = add(15, 25)
    let sq: Int = square(8)
    let av: Int = abs_value(-42)
    print("add(15, 25) = ", sum)
    print("square(8) = ", sq)
    print("abs_value(-42) = ", av)

    // Pattern Matching
    let status: Int = evaluate_status(200)
    print("Status Code 200 -> ", status)

    // Conditionals
    let grade: Int = classify_grade(95)
    print("Grade for 95 -> ", grade)

    // Loop & Factorial
    let fact: Int = compute_factorial(10)
    print("10! = ", fact)

    // Assertions
    assert(sum == 40)
    assert(sq == 64)
    assert(av == 42)
    assert(status == 1)
    assert(grade == 1)
    assert(fact == 3628800)

    print("===============================================================")
    print("✅ All Grammar v2 Subsystems Verified Successfully (.sora)")
    print("===============================================================")
    return 0
}
