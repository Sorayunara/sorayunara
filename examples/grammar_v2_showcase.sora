// ==============================================================================
// 🌌 Sorayunara (.sora) Complete Grammar v2 Showcase
// Organization: Sorayunara · Safe · Fast · Expressive · Zero-Boilerplate
// ==============================================================================

import std.io
import std.time

// 1. Struct & Data Record Definition
struct User {
    name: String,
    age: Int,
    is_active: Bool
}

// 2. Pure Functions & Return Expressions
fn add(a: Int, b: Int) -> Int {
    return a + b
}

fn square(x: Int) -> Int {
    return x * x
}

// 3. Pattern Matching & Enums
fn evaluate_status(code: Int) -> String {
    let result = match code {
        200 => "HTTP 200 OK",
        404 => "HTTP 404 Not Found",
        _   => "Unknown Status"
    }
    return result
}

// 4. Asynchronous Coroutines
async fn background_task(id: Int) -> String {
    print("Background worker #" + id.to_string() + " running.")
    return "Result from worker #" + id.to_string()
}

// 5. Main Program Execution
fn main() -> Int {
    print("===============================================================")
    print("🌌 SORAYUNARA (.sora) FULL GRAMMAR V2 EXECUTION DEMO")
    print("===============================================================")

    // Variable Bindings & Mutability
    let app_name: String = "Sorayunara Core"
    let mut counter: Int = 0
    counter = counter + 10
    print("App: " + app_name + " | Counter: " + counter.to_string())

    // Struct Instantiation
    let user = User {
        name: "Muhammad Lutfi",
        age: 21,
        is_active: true
    }
    print("User: " + user.name + " (Age: " + user.age.to_string() + ")")

    // Math & Function Calls
    let sum = add(15, 25)
    let sq = square(8)
    print("add(15, 25) = " + sum.to_string() + " | square(8) = " + sq.to_string())

    // Pattern Matching
    let status_text = evaluate_status(200)
    print("Status Evaluation: " + status_text)

    // Loops & Iterations
    let mut i: Int = 0
    print("Looping range 0..3:")
    while i < 3 {
        print("  Iteration index: " + i.to_string())
        i = i + 1
    }

    // Concurrency: Spawn & Await Task
    let task: Task<String> = spawn background_task(1)
    let msg: String = await task
    print("Received Task Msg: " + msg)

    print("===============================================================")
    print("✅ All Grammar v2 Subsystems Verified Successfully (.sora)")
    print("===============================================================")
    return 0
}
