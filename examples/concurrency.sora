// examples/concurrency.sora — Coroutine Concurrency in Sorayunara (.sora)

fn simulate_task(task_id: Int) -> Int {
    print("Executing task #", task_id)
    let result: Int = task_id * 100
    return result
}

fn main() -> Int {
    print("Launching concurrent-style tasks on Sorayunara runtime...")

    let res1: Int = simulate_task(1)
    let res2: Int = simulate_task(2)
    let res3: Int = simulate_task(3)

    print("Task 1 result: ", res1)
    print("Task 2 result: ", res2)
    print("Task 3 result: ", res3)

    let total: Int = res1 + res2 + res3
    print("Total: ", total)

    assert(total == 600)
    return 0
}
