// compiler/lexer.sora — Lexical Analyzer & Tokenizer in Pure Sorayunara
// Organization: Sorayunara

enum TokenKind {
    Fn,
    Let,
    Mut,
    Const,
    Struct,
    Enum,
    Trait,
    Impl,
    If,
    Else,
    While,
    For,
    In,
    Loop,
    Return,
    Match,
    Move,
    Unsafe,
    Async,
    Await,
    Spawn,
    Chan,
    Import,
    Pub,
    Test,
    Comptime,
    Identifier(String),
    Number(Int),
    StrLiteral(String),
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Equal,
    EqualEqual,
    NotEqual,
    LessThan,
    LessEqual,
    GreaterThan,
    GreaterEqual,
    Ampersand,
    Pipe,
    Bang,
    Arrow,
    FatArrow,
    Colon,
    ColonColon,
    Semicolon,
    Comma,
    Dot,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    EndOfFile
}

struct Token {
    kind: TokenKind,
    line: Int,
    column: Int
}

fn tokenize_source(source: &String) -> Int {
    let mut count: Int = 0
    let mut i: Int = 0
    let len: Int = source.len()

    while i < len {
        let ch: Char = source.char_at(i)
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' {
            i = i + 1
        } else {
            count = count + 1
            i = i + 1
        }
    }
    return count
}
