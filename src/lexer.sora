// src/lexer.sora — Lexical Scanner & Tokenizer in Sorayunara
// Organization: Sorayunara

struct Token {
    kind_id: Int,
    lexeme: String,
    line: Int,
    column: Int
}

fn tokenize(source: &String) -> Int {
    let mut count: Int = 0
    let mut i: Int = 0
    let len: Int = source.len()

    while i < len {
        count = count + 1
        i = i + 1
    }
    return count
}
