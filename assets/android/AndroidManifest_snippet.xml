<!-- Android Intent Filter for .sora file detection and custom icon -->
<!-- Paste inside your <activity> tag in AndroidManifest.xml -->

<intent-filter android:label="Sorayunara Source File" android:icon="@mipmap/ic_sora_file">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    
    <!-- Match by MIME type -->
    <data android:mimeType="text/x-sora" />
    <data android:mimeType="application/x-sorayunara" />
    <data android:mimeType="text/plain" />
    
    <!-- Match by .sora file extension -->
    <data android:scheme="file" />
    <data android:scheme="content" />
    <data android:host="*" />
    <data android:pathPattern=".*\\.sora" />
    <data android:pathSuffix=".sora" />
</intent-filter>
