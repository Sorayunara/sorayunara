// std/ffi.ae - Aether Standard Foreign Function Interface & C ABI Support

extern "C" {
    fn strlen(ptr: String) -> Int
    fn malloc(size: Int) -> Int
    fn free(ptr: Int)
}

struct RawPointer {
    address: Int
}

fn null_pointer() -> RawPointer {
    return RawPointer { address: 0 }
}

fn pointer_is_null(p: &RawPointer) -> Bool {
    return p.address == 0
}

fn pointer_offset(p: &RawPointer, offset: Int) -> RawPointer {
    return RawPointer { address: p.address + offset }
}

struct DynamicLibrary {
    handle: Int,
    path: String
}

fn load_library(path: String) -> DynamicLibrary {
    print("Loading dynamic library: ", path)
    return DynamicLibrary {
        handle: 1001,
        path: path
    }
}

fn get_symbol_address(lib: &DynamicLibrary, symbol_name: String) -> RawPointer {
    print("Resolving FFI symbol: ", symbol_name)
    return RawPointer { address: 9999 }
}
