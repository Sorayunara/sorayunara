// std/ffi.sora - Sorayunara Standard Foreign Function Interface & C ABI Support

extern "C" {
    fn strlen(ptr: String) -> Int
    fn malloc(size: Int) -> Int
    fn free(ptr: Int)
}

fn null_pointer() -> Int {
    return 0
}

fn pointer_is_null(p: Int) -> Bool {
    return p == 0
}

fn pointer_offset(p: Int, offset: Int) -> Int {
    return p + offset
}

fn load_library(path: String) -> Int {
    return 1001
}

fn get_symbol_address(handle: Int, symbol_name: String) -> Int {
    return 9999
}
