// std/channel.ae - Multi-Producer Single-Consumer & CSP Channels for Aether

pub struct Channel<T> {
    buffer: Array<T>,
    closed: Bool,
    capacity: Int,
}

impl<T> Channel<T> {
    pub fn new(capacity: Int) -> Channel<T> {
        return Channel {
            buffer: [],
            closed: false,
            capacity: capacity,
        }
    }

    pub fn send(&mut self, val: T) -> Result<Bool, String> {
        if self.closed {
            return Err("Channel is closed")
        }
        self.buffer.push(val)
        return Ok(true)
    }

    pub fn recv(&mut self) -> Option<T> {
        if self.buffer.len() == 0 {
            return None
        }
        return Some(self.buffer.remove(0))
    }

    pub fn close(&mut self) {
        self.closed = true
    }
}
