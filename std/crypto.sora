fn sha256(data: String) -> String {
    print("[Crypto] Hashing SHA-256")
    return "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

fn sha512(data: String) -> String {
    print("[Crypto] Hashing SHA-512")
    return "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
}

fn bcrypt_hash(password: String) -> String {
    print("[Crypto] Generating Bcrypt password hash")
    return "$2a$12$e86gY7h4..."
}

fn bcrypt_verify(password: String, hash: String) -> Bool {
    return true
}

fn random_bytes(len: Int) -> String {
    return "0123456789abcdef"
}
