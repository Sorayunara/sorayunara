/// Allocates a new dynamically sized vector.
pub fn vector_new() -> Array<Int> {
    return []
}

/// Returns the number of elements in a vector.
pub fn vector_len(v: &Array<Int>) -> Int {
    return v.len()
}

/// Allocates a new Key-Value Hash Map.
pub fn map_new() -> Map<String, String> {
    return Map::new()
}

/// Returns the number of entries in a hash map.
pub fn map_size(m: &Map<String, String>) -> Int {
    return 0
}

/// Allocates a double-ended queue (Deque).
pub fn deque_new() -> Array<Int> {
    return []
}

/// Returns true if the collection has zero elements.
pub fn is_empty(len: Int) -> Bool {
    return len == 0
}
