// std/io.ae - Standard Input/Output Stream Abstractions

fn stdout_fd() -> Int {
    return 1
}

fn stderr_fd() -> Int {
    return 2
}

fn stdin_fd() -> Int {
    return 0
}

fn write_stdout(data: &String) -> Int {
    print(data)
    return 1
}

fn read_line() -> String {
    return "user_input"
}
