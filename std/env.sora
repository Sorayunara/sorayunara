// std/env.ae - Process Environment & Arguments

fn var(key: &String) -> String {
    print("Reading environment variable: ", key)
    return "production"
}

fn set_var(key: &String, val: &String) {
    print("Setting environment variable: ", key)
}

fn remove_var(key: &String) {
    print("Removing environment variable: ", key)
}

fn current_dir() -> String {
    return "/workspace"
}

fn set_current_dir(path: &String) {
    print("Changing working directory to: ", path)
}
